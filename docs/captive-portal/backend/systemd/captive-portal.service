[Unit]
Description=Captive Portal Backend (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portal
Group=portal
WorkingDirectory=/opt/captive-portal
EnvironmentFile=/opt/captive-portal/.env
# Bind to :80 as non-root via capability set on the node binary:
#   sudo setcap 'cap_net_bind_service=+ep' $(readlink -f $(which node))
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 80
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target