// Prisma schema for the captive portal backend.
// SQLite for simplicity; swap provider/url for Postgres if desired.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id             String        @id @default(cuid())
  studentId      String        @unique
  nama           String?
  kelas          String?
  speedLimitKbps Int?
  // SQLite has no enum support. Allowed values: "PENDING" | "ACTIVE" | "DENIED".
  status         String        @default("PENDING")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  devices        Device[]
  syncJobs       RouterSyncJob[]

  @@index([status])
}

model Device {
  id         String   @id @default(cuid())
  macAddress String   @unique
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  approved   Boolean  @default(false)
  // Sync state values: "PENDING_SYNC" | "SYNCED" | "SYNC_FAILED".
  syncState     String    @default("PENDING_SYNC")
  syncAttempts  Int       @default(0)
  nextRetryAt   DateTime?
  lastSyncedAt  DateTime?
  lastSyncError String?
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  syncJobs   RouterSyncJob[]

  @@index([studentId])
  @@index([approved])
  @@index([syncState, nextRetryAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model PortalConfig {
  key   String @id
  value String?
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model RouterSyncJob {
  id           String   @id @default(cuid())
  deviceId     String?
  studentId    String?
  jobType      String
  payload      String?
  status       String   @default("PENDING")
  attempts     Int      @default(0)
  nextRetryAt  DateTime?
  lastError    String?
  lockId       String?
  lockedAt     DateTime?
  processedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  device Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt, createdAt])
  @@index([deviceId, jobType, status])
  @@index([studentId, jobType, status])
}